{# Rendered per lab VM by the nightagents tactic role. Random secrets are
   generated once per VM (deterministic per host via the password lookup seed). #}
{% set r1 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set r2 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set r3 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set r4 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set r5 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set r6 = lookup('password', '/dev/null', chars=['hex_digits'], length=48) %}
{% set watcher = 'watcher-' + r1[:12] %}
{% set kernel = 'kernel-' + r2[:12] %}
{% set research = 'research-' + r3[:12] %}
NIGHTAGENTS_ENVIRONMENT=development
POSTGRES_PASSWORD={{ r4 }}
NIGHTAGENTS_DATABASE_URL=sqlite:///./nightagents.db
NIGHTAGENTS_HANDOFF_SIGNING_SECRET={{ r1 }}
NIGHTAGENTS_APPROVAL_SIGNING_SECRET={{ r2 }}
NIGHTAGENTS_EXECUTION_GRANT_SECRET={{ r3 }}
NIGHTAGENTS_ELASTIC_WEBHOOK_SECRET={{ r5 }}
NIGHTAGENTS_OUTBOX_WEBHOOK_SECRET={{ r6 }}

NIGHTAGENTS_ELASTIC_URL=http://elasticsearch:9200
NIGHTAGENTS_ELASTIC_VERIFY_TLS=false
NIGHTAGENTS_ELASTIC_SOURCE_MAX_AGE_SECONDS=900
NIGHTAGENTS_MYTHIC_URL={{ ludus_rtv_burning_redirectors_mythic_url }}
NIGHTAGENTS_MYTHIC_API_KEY=
NIGHTAGENTS_MYTHIC_VERIFY_TLS={{ ludus_rtv_burning_redirectors_mythic_verify_tls }}

NIGHTAGENTS_INFRASTRUCTURE_MODE={{ ludus_rtv_burning_redirectors_infra_mode }}
NIGHTAGENTS_LAB_VICTIM_CONTAINER={{ ludus_rtv_burning_redirectors_lab_victim_container }}
NIGHTAGENTS_LAB_HOSTNAME={{ ludus_rtv_burning_redirectors_lab_hostname }}
NIGHTAGENTS_LAB_REDIRECTOR_MAP_JSON={{ ludus_rtv_burning_redirectors_lab_redirector_map | tojson }}
NIGHTAGENTS_LAB_DATA_STREAM=logs-redirector-demo

NIGHTAGENTS_MODEL_API_URL={{ ludus_rtv_burning_redirectors_model_api_url }}
NIGHTAGENTS_MODEL_API_KEY={{ ludus_rtv_burning_redirectors_model_api_key }}
NIGHTAGENTS_MODEL_NAME={{ ludus_rtv_burning_redirectors_model_name }}
NIGHTAGENTS_MODEL_ROLES_JSON={"skill_selector":{"provider":"local"},"predictor":{"provider":"local"}}
NIGHTAGENTS_MODEL_REQUEST_TIMEOUT_SECONDS=120

NIGHTAGENTS_SLACK_API_TOKEN={{ ludus_rtv_burning_redirectors_slack_bot_token }}
NIGHTAGENTS_SLACK_CHANNEL={{ ludus_rtv_burning_redirectors_slack_channel }}
NIGHTAGENTS_SLACK_SIGNING_SECRET={{ ludus_rtv_burning_redirectors_slack_signing_secret }}
NIGHTAGENTS_SLACK_APP_TOKEN={{ ludus_rtv_burning_redirectors_slack_app_token }}

NIGHTAGENTS_MCP_TOKENS_JSON={"{{ watcher }}":"nightwatcher","{{ kernel }}":"safety-kernel","{{ research }}":"research-agent"}
NIGHTAGENTS_MCP_ENDPOINTS_JSON={"elastic":{"url":"http://elastic-mcp:8101/mcp","token":"{{ watcher }}"},"mythic":{"url":"http://mythic-mcp:8102/mcp","token":"{{ watcher }}"},"memory":{"url":"http://memory-mcp:8103/mcp","token":"{{ watcher }}"},"infrastructure":{"url":"http://infrastructure-mcp:8104/mcp","token":"{{ watcher }}"},"third_party":{"url":"http://third-party-mcp:8105/mcp","token":"{{ watcher }}"}}
NIGHTAGENTS_SAFETY_MCP_ENDPOINTS_JSON={"mythic":{"url":"http://mythic-mcp:8102/mcp","token":"{{ kernel }}"},"infrastructure":{"url":"http://infrastructure-mcp:8104/mcp","token":"{{ kernel }}"}}
NIGHTAGENTS_RESEARCH_MCP_ENDPOINTS_JSON={"memory":{"url":"http://memory-mcp:8103/mcp","token":"{{ research }}"},"third_party":{"url":"http://third-party-mcp:8105/mcp","token":"{{ research }}"}}
NIGHTAGENTS_MCP_TRANSPORT=streamable-http
NIGHTAGENTS_MCP_HOST=127.0.0.1
NIGHTAGENTS_MCP_PORT=8100

NIGHTAGENTS_DETECTION_INTERVAL_SECONDS={{ ludus_rtv_burning_redirectors_detection_interval }}
NIGHTAGENTS_DETECTION_SOURCE=logs-redirector-demo
NIGHTAGENTS_AUTO_INVESTIGATE=true
NIGHTAGENTS_HANDOFF_TTL_MINUTES={{ ludus_rtv_burning_redirectors_handoff_ttl_minutes }}
NIGHTAGENTS_WORKER_INTERVAL_SECONDS=5
NIGHTAGENTS_API_URL=http://127.0.0.1:8000
NIGHTAGENTS_OPERATOR_ID=development-operator
