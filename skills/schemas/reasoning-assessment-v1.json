{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "phase",
    "confidence",
    "hypotheses",
    "prediction",
    "recommended_skill"
  ],
  "properties": {
    "phase": {
      "enum": [
        "discovery",
        "profiling",
        "correlation",
        "takedown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.9,
      "description": "Calibrated confidence in the assessment. Must not exceed 0.9: higher values are reserved for overwhelming multi-source evidence and are rejected by policy."
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prediction": {
      "type": "object"
    },
    "recommended_skill": {
      "enum": [
        "plan-callback-migration",
        "cool-down-redirector"
      ],
      "description": "The skill to recommend. Must be one of the two valid response skills."
    }
  },
  "additionalProperties": false
}
